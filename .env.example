APP_ENV=local
APP_VERSION=dev
LOG_LEVEL=debug

SERVICE_NAME=user-service

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=2s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=10s

GRPC_ADDR=:9090
GRPC_SHUTDOWN_TIMEOUT=10s
GRPC_MAX_RECV_MESSAGE_SIZE=4194304
GRPC_MAX_SEND_MESSAGE_SIZE=4194304
USER_SERVICE_GRPC_ADDR=:9091
SUBSCRIPTION_SERVICE_GRPC_ADDR=:9092
CONFIG_SERVICE_HTTP_ADDR=:8083
CONFIG_SERVICE_INTERNAL_BASE_URL=http://localhost:8083
CONFIG_SERVICE_PUBLIC_BASE_URL=http://localhost:8083

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=15432
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=30m

USER_SERVICE_POSTGRES_DSN=postgres://postgres:change-me@localhost:15432/dark_twenties_users?sslmode=disable
SUBSCRIPTION_SERVICE_POSTGRES_DSN=postgres://postgres:change-me@localhost:15432/dark_twenties_subscriptions?sslmode=disable
BILLING_SERVICE_POSTGRES_DSN=postgres://postgres:change-me@localhost:15432/dark_twenties_billing?sslmode=disable
TUNNEL_SERVICE_POSTGRES_DSN=postgres://postgres:change-me@localhost:15432/dark_twenties_tunnels?sslmode=disable
CONFIG_SERVICE_POSTGRES_DSN=postgres://postgres:change-me@localhost:15432/dark_twenties_configs?sslmode=disable
POSTGRES_DSN=postgres://postgres:change-me@localhost:15432/dark_twenties_users?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EVENTS_EXCHANGE=vpn.events.topic
RABBITMQ_COMMANDS_EXCHANGE=vpn.commands.direct
RABBITMQ_RETRY_EXCHANGE=vpn.retry
RABBITMQ_DLX_EXCHANGE=vpn.dlx

TG_BOT_LINK=https://t.me/thedarktwenties_bot
TG_BOT_TOKEN=
TG_MINI_APP_SECRET=
TELEGRAM_REQUEST_TIMEOUT=10s
TELEGRAM_POLL_TIMEOUT_SECONDS=30

RUNTIME_MONITOR_ENABLED=true
RUNTIME_MONITOR_INTERVAL=30s
RUNTIME_GOROUTINE_WARN_THRESHOLD=1000
RUNTIME_GOROUTINE_GROWTH_THRESHOLD=100

PPROF_ENABLED=false
PPROF_ADDR=127.0.0.1:6060
